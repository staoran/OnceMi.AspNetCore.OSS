<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <PackageId>EasyLink.Storage.QiniuKodo</PackageId>
    <AssemblyName>EasyLink.Storage.QiniuKodo</AssemblyName>
    <RootNamespace>EasyLink.Storage.QiniuKodo</RootNamespace>
    <Title>EasyLink.Storage.QiniuKodo</Title>
    <Description>EasyLink.Storage 的七牛 Kodo provider 包，提供 Qiniu Kodo 对象存储实现。</Description>
    <PackageTags>easylink;storage;object-storage;oss;provider;qiniu;kodo</PackageTags>
    <PackageReleaseNotes>2.0.0: Provider package split from EasyLink.Storage. Install with EasyLink.Storage to enable Qiniu Kodo object storage.</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EasyLink.Storage\EasyLink.Storage.csproj" />
    <PackageReference Include="Qiniu" Version="8.7.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\EasyLink.Storage\Services\QiniuOSSService.cs" Link="Services\QiniuOSSService.cs" />
    <Compile Include="..\EasyLink.Storage\Interface\Service\IQiniuOSSService.cs" Link="Interface\Service\IQiniuOSSService.cs" />
    <Compile Include="..\EasyLink.Storage\Models\Qiniu\QiniuApi.cs" Link="Models\Qiniu\QiniuApi.cs" />
    <Compile Include="..\EasyLink.Storage\Models\Qiniu\QiniuError.cs" Link="Models\Qiniu\QiniuError.cs" />
    <Compile Include="..\EasyLink.Storage\Models\Qiniu\QiniuFullBucketInfo.cs" Link="Models\Qiniu\QiniuFullBucketInfo.cs" />
    <Compile Include="..\EasyLink.Storage\Models\Qiniu\QiniuObjectMetadata.cs" Link="Models\Qiniu\QiniuObjectMetadata.cs" />
  </ItemGroup>
</Project>
