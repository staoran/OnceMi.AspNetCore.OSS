<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<PackageId>EasyLink.Storage</PackageId>
		<AssemblyName>EasyLink.Storage</AssemblyName>
		<RootNamespace>EasyLink.Storage</RootNamespace>
		<Title>EasyLink.Storage</Title>
		<Description>.NET 对象存储扩展包族。核心包是 EasyLink.Storage，各厂商实现拆为独立 provider 包，支持 Minio、阿里云 OSS、腾讯云 COS、七牛 Kodo、华为 OBS、百度 BOS、天翼 OOS 经典版。主库目标框架为 .NET Standard 2.1，示例和测试项目以 .NET 10 作为当前构建基线。</Description>
		<Company>TAORAN</Company>
		<Authors>EasyLink contributors</Authors>
		<Version>2.0.0</Version>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/staoran/OnceMi.AspNetCore.OSS</RepositoryUrl>
		<PackageProjectUrl>https://github.com/staoran/OnceMi.AspNetCore.OSS</PackageProjectUrl>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<RepositoryType>git</RepositoryType>
		<PackageTags>easylink;storage;object-storage;aspnetcore;oss;provider</PackageTags>
		<PackageReleaseNotes>2.0.0: Split EasyLink.Storage into a core package and separate provider packages. The core package now contains abstractions, DI registration, configuration, common models, and cache support without provider SDK dependencies.</PackageReleaseNotes>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>donetcore</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>donetcore</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.7" />
		<PackageReference Include="System.Text.Json" Version="10.0.7" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Services\**\*.cs" />
		<Compile Remove="SDK\**\*.cs" />
		<Compile Remove="Interface\Service\**\*.cs" />
		<Compile Remove="Models\BucketCorsRule.cs" />
		<Compile Remove="Models\ItemUploadInfo.cs" />
		<Compile Remove="Models\PolicyInfo.cs" />
		<Compile Remove="Models\Policy\Principal.cs" />
		<Compile Remove="Models\Policy\StatementItem.cs" />
		<Compile Remove="Models\Ctyun\**\*.cs" />
		<Compile Remove="Models\Huawei\**\*.cs" />
		<Compile Remove="Models\Qiniu\**\*.cs" />
	</ItemGroup>

</Project>
