<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Description>ASP.NET Core对象储存扩展包，支持Minio自建对象储存、阿里云OSS、腾讯云COS、七牛云Kodo、华为云OBS、百度云BOS、天翼云OOS经典版。</Description>
		<Company>staoran</Company>
		<Authors>staoran</Authors>
		<Version>2.0.0</Version>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<RepositoryUrl>https://github.com/staoran/OnceMi.AspNetCore.OSS</RepositoryUrl>
		<PackageProjectUrl>https://github.com/staoran/OnceMi.AspNetCore.OSS</PackageProjectUrl>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>2.0.0: 升级目标框架至 net8.0；升级所有 NuGet 依赖至最新版本；移除未使用的 ILoggerFactory；将华为云 SDK 日志替换为 .NET 原生 ILogger；修复 Minio v6 API 兼容性问题。</PackageReleaseNotes>
		<PackageTags>OSS;Minio;Aliyun;QCloud;Qiniu;HuaweiCloud;BaiduCloud;Ctyun;AspNetCore</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>donetcore</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>donetcore</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Aliyun.OSS.SDK.NetCore" Version="2.14.1" />
		<PackageReference Include="BceSdkDotNetCore" Version="1.0.6.1123" />
		<PackageReference Include="Minio" Version="6.0.3" />
		<PackageReference Include="Qiniu" Version="8.7.0" />
		<PackageReference Include="Tencent.QCloud.Cos.Sdk" Version="5.4.51" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\LICENSE">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

</Project>
