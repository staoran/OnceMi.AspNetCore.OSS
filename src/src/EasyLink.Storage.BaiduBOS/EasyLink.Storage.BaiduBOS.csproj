<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <PackageId>EasyLink.Storage.BaiduBOS</PackageId>
    <AssemblyName>EasyLink.Storage.BaiduBOS</AssemblyName>
    <RootNamespace>EasyLink.Storage.BaiduBOS</RootNamespace>
    <Title>EasyLink.Storage.BaiduBOS</Title>
    <Description>EasyLink.Storage 的百度 BOS provider 包，提供 Baidu BOS 对象存储实现。</Description>
    <PackageTags>easylink;storage;object-storage;oss;provider;baidu;baidu-bos</PackageTags>
    <PackageReleaseNotes>2.0.0: Provider package split from EasyLink.Storage. Install with EasyLink.Storage to enable Baidu BOS object storage.</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EasyLink.Storage\EasyLink.Storage.csproj" />
    <PackageReference Include="BceSdkDotNetCore" Version="1.0.6.1123" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\EasyLink.Storage\Services\BaiduOSSService.cs" Link="Services\BaiduOSSService.cs" />
    <Compile Include="..\EasyLink.Storage\Interface\Service\IBaiduOSSService.cs" Link="Interface\Service\IBaiduOSSService.cs" />
  </ItemGroup>
</Project>
