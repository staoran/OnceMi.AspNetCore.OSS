<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <PackageId>EasyLink.Storage.CtyunOOS</PackageId>
    <AssemblyName>EasyLink.Storage.CtyunOOS</AssemblyName>
    <RootNamespace>EasyLink.Storage.CtyunOOS</RootNamespace>
    <Title>EasyLink.Storage.CtyunOOS</Title>
    <Description>EasyLink.Storage 的天翼云 OOS 经典版 provider 包，提供 Ctyun OOS 对象存储实现。</Description>
    <PackageTags>easylink;storage;object-storage;oss;provider;ctyun;ctyun-oos</PackageTags>
    <PackageReleaseNotes>2.0.0: Provider package split from EasyLink.Storage. Install with EasyLink.Storage to enable Ctyun OOS object storage.</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EasyLink.Storage\EasyLink.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\EasyLink.Storage\Services\CtyunOSSService.cs" Link="Services\CtyunOSSService.cs" />
    <Compile Include="..\EasyLink.Storage\Interface\Service\ICtyunOSSService.cs" Link="Interface\Service\ICtyunOSSService.cs" />
    <Compile Include="..\EasyLink.Storage\Models\Ctyun\AccessControlPolicy.cs" Link="Models\Ctyun\AccessControlPolicy.cs" />
    <Compile Include="..\EasyLink.Storage\Models\Ctyun\BucketConfiguration.cs" Link="Models\Ctyun\BucketConfiguration.cs" />
    <Compile Include="..\EasyLink.Storage\Models\Ctyun\ListAllMyBucketsResult.cs" Link="Models\Ctyun\ListAllMyBucketsResult.cs" />
    <Compile Include="..\EasyLink.Storage\Models\Ctyun\ListBucketResult.cs" Link="Models\Ctyun\ListBucketResult.cs" />
    <Compile Include="..\EasyLink.Storage\SDK\Ctyun\**\*.cs" LinkBase="SDK\Ctyun" />
  </ItemGroup>
</Project>
