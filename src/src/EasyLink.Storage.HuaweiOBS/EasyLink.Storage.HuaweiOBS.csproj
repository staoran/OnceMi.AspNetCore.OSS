<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <PackageId>EasyLink.Storage.HuaweiOBS</PackageId>
    <AssemblyName>EasyLink.Storage.HuaweiOBS</AssemblyName>
    <RootNamespace>EasyLink.Storage.HuaweiOBS</RootNamespace>
    <Title>EasyLink.Storage.HuaweiOBS</Title>
    <Description>EasyLink.Storage 的华为 OBS provider 包，提供 Huawei OBS 对象存储实现。</Description>
    <PackageTags>easylink;storage;object-storage;oss;provider;huawei;huawei-obs</PackageTags>
    <PackageReleaseNotes>2.0.0: Provider package split from EasyLink.Storage. Install with EasyLink.Storage to enable Huawei OBS object storage.</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EasyLink.Storage\EasyLink.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\EasyLink.Storage\Services\HaweiOSSService.cs" Link="Services\HaweiOSSService.cs" />
    <Compile Include="..\EasyLink.Storage\Interface\Service\IHaweiOSSService.cs" Link="Interface\Service\IHaweiOSSService.cs" />
    <Compile Include="..\EasyLink.Storage\Models\Huawei\BucketStorageInfo.cs" Link="Models\Huawei\BucketStorageInfo.cs" />
    <Compile Include="..\EasyLink.Storage\SDK\HuaweiCloud\**\*.cs" LinkBase="SDK\HuaweiCloud" />
  </ItemGroup>
</Project>
