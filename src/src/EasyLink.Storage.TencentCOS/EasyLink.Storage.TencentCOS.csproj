<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <PackageId>EasyLink.Storage.TencentCOS</PackageId>
    <AssemblyName>EasyLink.Storage.TencentCOS</AssemblyName>
    <RootNamespace>EasyLink.Storage.TencentCOS</RootNamespace>
    <Title>EasyLink.Storage.TencentCOS</Title>
    <Description>EasyLink.Storage 的腾讯云 COS provider 包，提供 Tencent COS 对象存储实现。</Description>
    <PackageTags>easylink;storage;object-storage;oss;provider;tencent;tencent-cos;qcloud</PackageTags>
    <PackageReleaseNotes>2.0.0: Provider package split from EasyLink.Storage. Install with EasyLink.Storage to enable Tencent COS object storage.</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EasyLink.Storage\EasyLink.Storage.csproj" />
    <PackageReference Include="Tencent.QCloud.Cos.Sdk" Version="5.4.51" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\EasyLink.Storage\Services\QCloudOSSService.cs" Link="Services\QCloudOSSService.cs" />
    <Compile Include="..\EasyLink.Storage\Interface\Service\IQCloudOSSService.cs" Link="Interface\Service\IQCloudOSSService.cs" />
  </ItemGroup>
</Project>
